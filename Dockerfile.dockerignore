# Copy declared source inputs, not arbitrary files from a local checkout.
# Other Dockerfiles keep the shared root policy.
*
!.dockerignore
!.gitignore
!AGENTS.md
!CONTRIBUTING.md
!Dockerfile
!Dockerfile.dockerignore
!LICENSE
!README.md
!artisan
!composer.json
!composer.lock
!docker-compose.yml
!docker-compose.published.yml
!docker-compose.php.yml
!docker-compose.small-cluster.yml
!docker-compose.dedicated-matching.yml
!docker-compose.failover-rehearsal.yml
!docker-compose.memo-rolling.yml
!phpunit.xml
!regression-corpus-policy.json
!sonar-project.properties
!uv.toml
!.github/**
!app/**
!benchmarks/**
!bin/**
!bootstrap/**
!config/**
!database/**
!docker/**
!docs/**
!k8s/**
!public/**
!resources/**
!routes/**
!rust/**
!scripts/**
!static/**
!storage/**

# The declared root template is public; runtime credentials stay outside the image.
**/.env
**/.env.*
!.env.example
**/.secrets
**/.secrets/**
**/.aws
**/.aws/**
**/.ssh
**/.ssh/**
**/.docker
**/.docker/**
**/auth.json
**/.npmrc
**/.netrc
**/.pypirc
**/.tmp
**/.git
**/.git/**

# Keep directory scaffolding, not local configuration, data, keys or uploads.
bootstrap/cache/**
!bootstrap/cache/.gitignore
storage/**
!storage/**/.gitignore
public/storage
public/hot
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.db
**/*.db-*

# Application dependencies are installed from the verified lock during build.
**/node_modules
**/.venv
**/__pycache__
rust/target
benchmarks/capacity/v1/bindings/php/vendor
benchmarks/capacity/v1/bindings/python/.deps
benchmarks/capacity/v1/bindings/rust/target
scripts/conformance/server-parity/vendor
scripts/conformance/server-parity/worker-fencing-sdk/vendor
scripts/conformance/server-parity/corrected-markers/php/vendor
scripts/conformance/server-parity/corrected-markers/rust/target
