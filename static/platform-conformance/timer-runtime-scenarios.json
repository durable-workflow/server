{
  "schema": "durable-workflow.v2.platform-conformance.runtime-scenarios",
  "version": 1,
  "category": "timer_runtime_contract",
  "suite_schema": "durable-workflow.v2.platform-conformance.suite",
  "suite_version": 15,
  "description": "Public scenario manifest for timer and sleep conformance. The current handoff is executable from the published server image and proves normal sleep completion, worker restart while sleeping, server restart while sleeping, replay after timer fire, concurrent timers with distinct deadlines, cancellation while waiting, and operator-visible waiting state when the focused shards run.",
  "fixture_type": "published_artifact_runtime_scenario_manifest",
  "result_schema": "durable-workflow.v2.timer-runtime.result",
  "result_version": 1,
  "result_statuses": [
    "pass",
    "fail",
    "unsupported",
    "not_covered",
    "runner_blocked"
  ],
  "artifact_policy": {
    "published_artifacts_only": true,
    "requires_published_artifact_versions": true,
    "rejects_placeholder_versions": true,
    "implementation_tests_are_not_sources": true,
    "required_artifacts": [
      "server",
      "cli",
      "workflow-php",
      "sdk-python",
      "waterline"
    ],
    "release_artifact_aliases": {
      "workflow-php": [
        "workflow"
      ]
    },
    "forbidden_sources": [
      "local_product_source_checkout",
      "workspace_repo_as_artifact_under_test"
    ],
    "placeholder_version_examples": [
      "latest",
      "current",
      "head",
      "unresolved",
      "placeholder",
      "<latest>",
      "${VERSION}",
      "{{ version }}"
    ]
  },
  "common_result_evidence": [
    "scenario_id",
    "status",
    "started_at",
    "finished_at",
    "generated_at",
    "outcome",
    "runner_blocked",
    "artifact_versions",
    "observed_outputs",
    "linked_findings"
  ],
  "required_scenarios": [
    "normal_sleep_completion",
    "worker_restart_while_sleeping",
    "server_restart_while_sleeping",
    "replay_after_timer_fire",
    "concurrent_timers_distinct_deadlines",
    "cancellation_while_waiting",
    "operator_visible_timer_waiting_state"
  ],
  "scenarios": [
    {
      "id": "normal_sleep_completion",
      "description": "A workflow sleep/timer completes only after the recorded wake-up deadline and returns the expected result.",
      "required_evidence": [
        "workflow_id",
        "sleep_requested_at",
        "wake_up_at",
        "completed_at",
        "workflow_result"
      ],
      "required_behavior": "workflow_sleep_completes_after_recorded_wake_up_without_early_resume"
    },
    {
      "id": "worker_restart_while_sleeping",
      "description": "A sleeping workflow survives worker restart, resumes after the timer fires, and does not produce duplicate resumes.",
      "required_evidence": [
        "workflow_id",
        "sleep_started_at",
        "worker_restart_window",
        "wake_up_at",
        "completed_at",
        "timer_fire_count",
        "duplicate_resume_count"
      ],
      "required_behavior": "worker_restart_does_not_drop_or_duplicate_a_sleeping_timer"
    },
    {
      "id": "server_restart_while_sleeping",
      "description": "A sleeping workflow survives server restart, recovers waiting timer state, and completes after the timer deadline.",
      "required_evidence": [
        "workflow_id",
        "sleep_started_at",
        "server_restart_window",
        "wake_up_at",
        "completed_at",
        "timer_state_recovered",
        "timer_fire_count",
        "duplicate_resume_count"
      ],
      "required_behavior": "server_restart_recovers_waiting_timer_state_and_completes_after_wake_up"
    },
    {
      "id": "replay_after_timer_fire",
      "description": "Replay after a timer has fired is deterministic and does not schedule duplicate timer commands.",
      "required_evidence": [
        "workflow_id",
        "timer_id",
        "fired_at",
        "replay_started_at",
        "replayed_event_ids",
        "replayed_event_types",
        "duplicate_timer_commands"
      ],
      "required_behavior": "replay_after_timer_fire_is_deterministic_and_does_not_schedule_duplicate_timers"
    },
    {
      "id": "concurrent_timers_distinct_deadlines",
      "description": "Concurrent timers with distinct wake-up deadlines resume in deadline order, never fire before wake_up_times, and never fire more than once.",
      "required_evidence": [
        "wake_up_times",
        "observed_resume_order",
        "fired_at_times",
        "fire_counts"
      ],
      "required_behavior": "resume_order_matches_wake_up_times_no_early_fires_no_duplicate_fires"
    },
    {
      "id": "cancellation_while_waiting",
      "description": "Cancelling a workflow while it is waiting on a timer records cancellation before the timer wake-up, prevents post-cancel firing, and ends in a documented terminal workflow status.",
      "required_evidence": [
        "cancellation_requested_at",
        "wake_up_at",
        "fired_after_cancel",
        "workflow_status"
      ],
      "allowed_terminal_workflow_statuses": [
        "cancelled",
        "terminated",
        "failed",
        "completed"
      ]
    },
    {
      "id": "operator_visible_timer_waiting_state",
      "description": "Operators can observe an explicit waiting or timer-waiting workflow state through CLI, Waterline, or a public API response.",
      "required_evidence": [
        "status",
        "surface"
      ],
      "explicit_waiting_statuses": [
        "waiting",
        "timer_waiting",
        "waiting_on_timer",
        "waiting_for_timer"
      ],
      "recognized_public_surfaces": [
        "cli",
        "waterline",
        "public_api"
      ]
    }
  ],
  "scenario_requirements": {
    "normal_sleep_completion": {
      "evidence": [
        "workflow_id",
