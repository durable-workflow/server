      "summary": "Probe future and unsupported-major protocol shapes derived from the exact published Server authority.",
      "operations": [
        "probe exact current protocol authority",
        "probe future client boundary",
        "probe future worker boundary",
        "probe future observer boundary",
        "probe future server boundary"
      ],
      "pass_criteria": [
        "the exact current published tuple interoperates using the advertised protocols",
        "a supported older worker protocol negotiates without installing historical prerelease packages",
        "outside-window forward skew refuses before mutation, registration, dropped work, or stale render",
        "the error context explains the supported version range"
      ]
    },
    {
      "id": "request_response_capture_for_skewed_operations",
