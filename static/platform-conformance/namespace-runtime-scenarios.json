{
  "schema": "durable-workflow.v2.platform-conformance.runtime-scenarios",
  "version": 1,
  "category": "namespace_runtime_contract",
  "suite_schema": "durable-workflow.v2.platform-conformance.suite",
  "suite_version": 32,
  "description": "Public scenario manifest for Temporal-parity namespace conformance. Harnesses use these scenario ids and required fields when evaluating published Durable Workflow artifacts.",
  "fixture_type": "published_artifact_runtime_scenario_manifest",
  "result_schema": "durable-workflow.v2.namespace-runtime.result",
  "result_version": 1,
  "result_statuses": [
    "pass",
    "fail",
    "unsupported",
    "not_covered",
    "runner_blocked"
  ],
  "artifact_policy": {
    "published_artifacts_only": true,
    "requires_resolved_versions": true,
    "implementation_tests_are_not_sources": true
  },
  "common_result_evidence": [
    "suite_version",
    "scenario_id",
    "status",
    "generated_at",
    "published_artifact_versions",
    "namespace_topology",
    "runtime_matrix",
    "observed_outputs",
    "linked_findings"
  ],
  "scenario_requirements": {
    "published_artifact_install_only": {
      "required_fields": [
        "server_image",
        "cli_release",
        "sdk_php_package",
        "sdk_python_package",
        "waterline_artifact"
      ]
    },
    "namespace_create_update_describe_and_list": {
      "required_fields": [
        "created_namespaces",
        "updated_namespace",
        "described_namespaces",
        "listed_namespaces"
      ]
    },
    "workflow_cross_namespace_visibility_isolation": {
      "required_fields": [
        "tenant_a_workflow",
        "tenant_b_workflow",
        "tenant_a_list_excludes_tenant_b",
        "tenant_b_describe_tenant_a_denied"
      ]
    },
    "workflow_cross_namespace_mutation_isolation": {
      "required_fields": [
        "same_namespace_signal_succeeds",
        "same_namespace_cancel_succeeds",
        "cross_namespace_signal_denied",
        "cross_namespace_cancel_denied"
      ]
    },
    "php_worker_task_queue_namespace_isolation": {
      "required_fields": [
