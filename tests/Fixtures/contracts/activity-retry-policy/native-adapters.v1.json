    "sha256": "8d576f1d50bcbfb123cb09682a4fbac53cb018a3cd369021c38d69866849781c",
    "case_count": 54,
    "mutate_canonical_rows": false
  },
  "authority": {
    "decision": "https://github.com/durable-workflow/.github/issues/219#issuecomment-6643667500",
    "native_bindings": "https://github.com/durable-workflow/.github/issues/219#issuecomment-6647329559",
    "native_reference_commit": "ea993064428fa9e0294520aa3efd498bef5b64dc",
    "capability": "activity_retry_delay_override_v1",
    "failure_override_field": "failure.next_retry_delay_seconds"
  },
  "executor_requirements": {
    "context": "otherwise valid synthetic authorized activity failure; original task/run/execution/attempt identity and complete before/after durable snapshot",
    "carrier": "the actual native HTTP handler and authoritative failure transaction; no scenario-only decision model",
    "raw_lexemes": "splice only the declared synthetic lexeme into an otherwise valid request; these strings are test bytes, not JSON numeric fixture values",
    "typed_cases": "also exercise every canonical invalid_override_* case as its original actual JSON type",
    "time": "one fixed authoritative failure sample retaining subsecond precision; each supported backend's checked bindable timestamp range",
    "snapshots": "task/attempt/activity/history/receipt state, original deadlines and retry-task/event counts; no raw payload, credential or provider error output",
    "retention": "compare the committed engine disposition and original availability after uncertainty; never recompute at replay time",
    "result_scope": "an absent executor, unavailable backend or unimplemented version-2 producer is unqualified, never pass"
  },
  "response_contracts": {
    "bindings": {
      "$reason": "the case expected.reason, or its explicitly named expected.loser.reason",
      "$task_id": "the submitted HTTP path task ID; not a looked-up foreign identity",
      "$activity_attempt_id": "the original submitted body.activity_attempt_id",
      "$protocol_version": "exact version in the independently pinned source-under-test worker manifest; native reference is 1.20",
      "$server_capabilities": "the entire independently pinned source-under-test capability manifest, deep exact equality; do not learn expected values from the failure response"
    },
    "matching": "Resolve only the declared binding strings; compare the complete JSON object with exact keys and actual JSON types. No extra/missing field or arbitrary failure status passes. The worker protocol response header must equal the independently pinned protocol version.",
    "reason_message_refusal": {
      "body": {
        "reason": "$reason",
        "message": "$reason",
        "protocol_version": "$protocol_version",
        "server_capabilities": "$server_capabilities"
      },
      "recorded_member": "absent, not false or null",
      "next_task_id_member": "absent, not null"
    },
    "activity_task_not_found": {
      "body": {
        "task_id": "$task_id",
        "activity_attempt_id": "$activity_attempt_id",
        "error": "Activity task not found.",
        "reason": "task_not_found",
        "protocol_version": "$protocol_version",
        "server_capabilities": "$server_capabilities"
      },
      "recorded_member": "absent, not false or null",
      "next_task_id_member": "absent, not null"
    },
    "stale_activity_acknowledgement": {
      "body": {
        "task_id": "$task_id",
        "activity_attempt_id": "$activity_attempt_id",
        "outcome": "failed",
        "recorded": false,
        "reason": "stale_attempt",
        "next_task_id": null,
        "protocol_version": "$protocol_version",
        "server_capabilities": "$server_capabilities"
      }
    }
  },
  "identity_isolation": {
    "scope": "Future isolated source-test fixture seeding only; caller run/execution fields do not establish authority. Ignored request fields are not a mismatch control.",
    "baseline": {
      "namespace": "S",
      "task": "T",
      "run": "R",
      "activity_execution": "E",
      "activity_attempt": "A",
      "lease_owner": "W",
      "task_attempt_count": 1,
      "activity_attempt_number": 1,
      "activity_execution_attempt_count": 1,
      "current_attempt_id": "A",
      "max_attempts": 3,
      "task_status": "leased",
      "attempt_status": "running",
      "activity_status": "running",
      "run_status": "running",
      "lease_and_original_deadlines": "strictly after the fixed failure sample"
    },
    "alternate_rows": "T2/A2/E2 form an independently valid current activity in the same R and S, also leased to W with count 1; R2 is another active run in S. W2 is another registered synthetic owner. All alternate rows exist and are readable.",
    "rule": "Start each row from a fresh valid baseline. Apply only the named request or durable-edge mutation before the before-snapshot. Every unlisted axis, auth/protocol gate, valid override and complete failure remains at baseline. Compare all original and alternate rows after refusal.",
    "positive_control": "The unmutated baseline must reach the actual version-2 failure path and record its selected retry. Setup/constraint failure, absent producer, backend/codec/internal error or a refusal on another axis is unqualified, never this negative passing.",
    "response_source": {
      "prepare_order": "rust/src/runtime/execution.rs::Runtime::fail_activity -> prepare_failure -> backend fail_activity",
      "attempt_order": "rust/src/runtime/activity_failures.rs::Store::fail_activity",
      "namespace_lookup": "rust/src/runtime/store.rs::task_row",
      "replacement": "rust/src/runtime/worker_management.rs::release_replaced_activity_leases",
      "http_envelope": "rust/src/runtime/http.rs::activity_not_found and worker_protocol_envelope; rust/src/runtime/mod.rs::RuntimeError::into_response"
    },
    "required_source_boundary": "These are required version-2 adoption controls, not an executing result or a claim that reference v1 implements each cross-graph guard. Return any missing task/run/execution consistency check in the future v2 source review; generic backend refusal never passes."
  },
  "refusal_precedence": {
    "order": [
      "existing authentication/namespace authorization and protocol admission",
      "JSON extraction",
      "strict supplied-override JSON type and portable integer range validation in failure preparation, before storage authority lookup",
      "original namespace/task/attempt/lease/deadline authority",
      "non-retryable then exhausted-attempt terminal classification, then cap/deadline retry selection"
    ],
    "scope": "This selects input-before-storage-authority for a malformed supplied override after successful auth/protocol admission. The new strict override validation is a required future source change, not behavior implemented by this data.",
    "non_disclosure": "The same malformed valid-JSON override returns the same closed 422 body for an owned stale task and a foreign/missing task in another authorized namespace. Do not query or echo task existence, foreign run/execution identities or terminal state before that refusal."
  },
