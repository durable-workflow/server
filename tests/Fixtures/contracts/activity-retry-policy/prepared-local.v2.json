  "adoption_gates": [
    "General reconciles the prepared-timeout projection before final companion freeze",
    "Core accepts the proposed closed retry_disposition fields and normalized snapshot/range binding",
    "Server binds the full HTTP envelope/refusal matrix to the installed future prepared implementation",
    "Native implements the prepared role and validator/transaction writer before advertisement",
    "Actual native/database/SDK/installed qualification and release remain separate"
  ],
  "mode_gate": {
    "conjunction": {
      "installed_prepared_local_role": true,
      "capability_activity_retry_delay_override_v1": true,
      "local_contract_version": 2,
      "retained_snapshot_version": 2,
      "original_claim_supports_selected_local_v2_mode": true
    },
    "literal_types": true,
    "remote_capability_alone_suffices": false,
    "unanchored_record_local_activity_batch": "version 1 only; never reinterpreted as an anchored version-2 result"
  },
  "prepared_report": {
    "boundary": "report object passed to the existing per-attempt recordLocalActivityOutcome flow; not the 11-field record_local_activity batch",
    "unknown_members": "refuse before publication or a further callback",
    "completed": {
      "required": [
        "outcome",
        "result"
      ],
      "optional": [
        "payload_codec"
      ],
      "outcome": "completed",
      "result": "existing validated encoded Avro result; codec must resolve to avro"
    },
    "failed": {
      "required": [
        "outcome",
        "message"
      ],
      "optional": [
        "exception_type",
        "non_retryable",
        "next_retry_delay_seconds"
      ],
      "outcome": "failed",
      "message": "existing string",
      "exception_type": "existing nonblank UTF-8 string, at most 255 bytes; existing RuntimeException default if absent",
      "non_retryable": "Boolean only; existing false default if absent",
      "next_retry_delay_seconds": "optional actual JSON integer in [0,9007199254740991]; null/Boolean/string/floating lexeme/refused"
    },
    "timed_out": {
      "required": [
        "outcome"
      ],
      "optional": [],
      "outcome": "timed_out",
      "classification": "engine-owned and actually due; no worker override, timeout kind, delay or failure timestamp"
    },
    "worker_forbidden": [
      "retry_disposition",
      "backoff_seconds",
      "retry_backoff_seconds",
      "retry_available_at",
      "failure_time",
      "original_schedule_to_close_deadline_at",
      "snapshot_version"
    ]
  },
  "clock": {
    "sample": "one engine UTC sample after strict request validation and canonical authority locks; the same sample drives fresh temporal fences and the retry decision",
    "publication": "retained only with the first transaction that commits; rollback publishes neither a sample nor decision",
    "duplicate": "return the matching committed per-attempt receipt and decision; never resample or rerun policy for that receipt",
    "original_deadline": "stored prepared execution schedule_to_close_deadline_at, checked against correlated original preparation/start authority",
    "not_anchors": [
      "duplicate prepare response server_time",
      "batch commit time",
      "worker absolute time",
      "backdated version-1 batch timestamps"
    ],
    "serialization": "UTC RFC3339 with exactly six fractional digits and Z; nullable original schedule-to-close deadline",
    "prepared_timeout_projection": "preserve existing engine timeout precedence at an already-due deadline; a valid earlier application failure whose selected availability reaches the deadline remains an application failure with terminal retry-delay disposition"
  },
  "retry_disposition_proposal": {
    "boundary": "engine-owned object shared exactly by the stored outcome metadata and its prepared receipt; never accepted in a worker report",
    "common_required": {
      "contract_version": 2,
      "snapshot_version": 2,
      "decision": "scheduled or terminal",
      "failure_time": "the stored first accepted engine sample",
      "original_schedule_to_close_deadline_at": "stored UTC timestamp or null"
    },
    "common_optional": {
      "requested_delay_seconds": "present iff the valid failed report supplied next_retry_delay_seconds; exact requested integer, including zero; diagnostic input does not prove application"
    },
    "scheduled_required": {
      "candidate_delay_seconds": "selected nonnegative portable integer",
      "maximum_interval_seconds": "finite cap from retained snapshot 2",
      "retry_available_at": "checked failure_time plus selected seconds, strictly before original deadline if set"
    },
    "scheduled_forbidden": [
      "terminal_classification"
    ],
    "terminal_required": {
      "terminal_classification": [
        "non_retryable",
        "attempts_exhausted",
        "retry_delay_exceeds_policy_cap",
        "retry_delay_exceeds_schedule_to_close",
        "engine_timeout"
      ]
    },
    "terminal_delay_classifications": [
      "retry_delay_exceeds_policy_cap",
      "retry_delay_exceeds_schedule_to_close"
    ],
    "terminal_delay_required": [
      "candidate_delay_seconds",
      "maximum_interval_seconds"
    ],
    "terminal_without_selection": [
      "non_retryable",
      "attempts_exhausted",
      "engine_timeout"
    ],
    "terminal_without_selection_forbidden": [
      "candidate_delay_seconds",
      "maximum_interval_seconds"
    ],
    "terminal_forbidden": [
      "retry_available_at"
    ],
    "unknown_members": "refused by a future consumer; never silently ignored"
  },
  "engine_receipt_proposal": {
    "existing_required": [
      "recorded",
      "duplicate",
      "reason",
      "event_id",
      "event_type",
      "workflow_run_id",
      "workflow_task_id",
      "workflow_task_attempt",
      "activity_execution_id",
      "activity_attempt_id",
      "worker_attempt_id",
      "recorded_at",
      "claim_released",
      "created_task_ids"
    ],
    "recorded": true,
    "reason": null,
    "new_optional": [
      "retry_disposition"
    ],
    "retry_disposition_present": "for a version-2 failed/timeout engine outcome; absent for a genuinely completed outcome",
    "scheduled": {
      "event_type": "ActivityRetryScheduled",
      "claim_released": true,
      "created_task_ids": "exactly one retained retry workflow task ID",
      "retry_disposition": "scheduled"
    },
    "terminal_failed": {
      "event_type": "ActivityFailed",
      "claim_released": false,
      "created_task_ids": [],
      "retry_disposition": "terminal"
    },
    "terminal_timeout": {
      "event_type": "ActivityTimedOut",
      "claim_released": false,
      "created_task_ids": [],
      "retry_disposition": "terminal, with engine-owned timeout provenance"
    },
    "completed": {
      "event_type": "ActivityCompleted",
      "claim_released": false,
      "created_task_ids": [],
      "retry_disposition": "absent"
    },
    "http_boundary": "this closes the engine receipt object only; controller history_refresh_page_token, protocol envelope and refusal HTTP status/body require their own exact source binding before adoption"
  },
  "history": {
    "identity": "same run/execution/real attempt/worker attempt/original task epoch as the prepared outcome receipt",
    "scheduled": "one ActivityRetryScheduled for the real failed attempt, with matching stored retry_disposition, retry_available_at and actual selected retry_backoff_seconds; no following attempt exists until independently prepared",
    "terminal": "one existing ActivityFailed or ActivityTimedOut outcome for the real attempt; matching retry_disposition; no retry task, following attempt/start or ActivityRetryScheduled",
    "failure_preservation": "cap/deadline retry termination preserves the admitted application failure/type; already-due engine timeout preserves engine timeout provenance instead",
    "cold_replay": "consume the stored decision and availability; do not evaluate the current policy or clock"
  },
  "ranges": {
    "portable_integer_minimum": 0,
    "portable_integer_maximum": 9007199254740991,
    "legacy_batch_backoff_ceiling_seconds": 86400,
    "legacy_batch_attempt_count_ceiling": 100,
    "v2_inherits_these_batch_ceilings": false,
    "checked_selection": "a selected retry must also fit the backend duration arithmetic and resulting bindable UTC timestamp before writes; no wrap, clamp, float coercion or immediate fallback",
    "terminal_candidate": "a portable diagnostic integer is not an executed duration or retry availability",
    "remaining_snapshot_binding": "Core must return exact policy/snapshot keys, finite max-attempt/list bounds and existing timeout field bounds; this proposal does not invent them from the batch limits"
  },
