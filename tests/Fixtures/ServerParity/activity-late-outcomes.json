{
  "schema": "durable-workflow.server-parity-fixture/v1",
  "id": "activity-late-outcomes",
  "review_state": "reviewed",
  "contract": "An activity outcome that arrives after the attempt's deadline (published Server 2.11.7), over raw worker HTTP on protocol 1.20 in a fresh namespace. Each case schedules one activity with a two-second start-to-close, schedule-to-close or heartbeat deadline, claims it, and completes or fails it 3.5 seconds later. The outcome is refused 409 and records nothing: with the deadline's own timeout reason while the timeout sweep has not yet closed the attempt, or stale_attempt once it has. Which one a run sees is a race with the sweep on both servers, so the contract accepts either and nothing else. The sweep then records exactly one ActivityTimedOut of the deadline's kind, and the parent resumes. Embedded applications have no worker protocol.",
  "workflow_type": "parity.v1.echo",
  "input": {
    "message": "activity late outcomes λ",
    "count": 9007199254740993,
    "optional": null
  },
