ARG SERVER_IMAGE=durableworkflow/server@sha256:5d435d14fdbe3acc991ae591a155864f132cefbfbf1b53b724a8e7b006a91612
FROM composer:2.10.3@sha256:da624c2c705d54e2f5a9bb77a5dc6c7d091711433ebefd7035672e84c2010fee AS checked-ca

FROM ${SERVER_IMAGE}

RUN apt-get update \
    && apt-get install -y --no-install-recommends $PHPIZE_DEPS libbrotli-dev libssl-dev pkg-config \
    && pecl install openswoole-26.2.0 \
    && docker-php-ext-enable openswoole \
    && rm -rf /var/lib/apt/lists/*

# Composer trusts only the pinned Composer image's checked CA store here
# (GHSA-6q48-6c7w-9gw2); this base image's own store may hold a withdrawn root.
COPY --from=checked-ca /etc/ssl/certs/ca-certificates.crt /etc/composer-trust/ca.pem
RUN install -d -m 0555 /etc/composer-trust/no-ca-directory
ENV COMPOSER_CAFILE=/etc/composer-trust/ca.pem COMPOSER_CAPATH=/etc/composer-trust/no-ca-directory
RUN composer require 'laravel/octane:2.20.0' 'laminas/laminas-diactoros:3.8.0' \
        'symfony/psr-http-message-bridge:7.4.8' \
        --update-no-dev --no-interaction --no-progress --no-scripts \
    && php artisan package:discover --no-ansi \
    && php artisan octane:install --server=swoole --no-interaction

ENTRYPOINT ["server-entrypoint"]
CMD ["php", "artisan", "octane:start", "--server=swoole", "--host=0.0.0.0", "--port=8080", "--workers=4"]
