ARG PHP_IMAGE=php:8.3-cli
# The pinned image's CA store is checked (GHSA-6q48-6c7w-9gw2).
FROM composer:2.10.3@sha256:da624c2c705d54e2f5a9bb77a5dc6c7d091711433ebefd7035672e84c2010fee AS dependencies
WORKDIR /sdk
COPY scripts/perf/sdk-php/composer.json scripts/perf/sdk-php/composer.lock ./
RUN composer install --no-dev --no-interaction --no-progress --prefer-dist

FROM ${PHP_IMAGE}
RUN docker-php-ext-install pcntl
WORKDIR /app
COPY benchmarks/capacity/v1/bindings/php/capacity_adapter.php benchmarks/capacity/v1/bindings/php/capacity_adapter.php
COPY scripts/perf/sdk-php/composer.json scripts/perf/sdk-php/composer.lock benchmarks/capacity/v1/bindings/php/
COPY --from=dependencies /sdk/vendor benchmarks/capacity/v1/bindings/php/vendor
COPY scripts/perf/standard_workflow_soak.php scripts/perf/standard_workflow_soak.php
COPY scripts/perf/standard-workflow-burst.php scripts/perf/standard-workflow-burst.php
COPY scripts/perf/standard-workflow-offered.php scripts/perf/standard-workflow-offered.php
COPY scripts/perf/idle-poll-probe.php scripts/perf/idle-poll-probe.php
USER 1000:1000
ENTRYPOINT ["php"]
CMD ["benchmarks/capacity/v1/bindings/php/capacity_adapter.php", "worker"]
