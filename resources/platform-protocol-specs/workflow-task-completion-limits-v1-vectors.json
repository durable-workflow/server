{
  "schema": "durable-workflow.workflow-task-completion-limits.v1",
  "issue": "https://github.com/durable-workflow/server/issues/1136",
  "measurement": "complete_encoded_json_http_request_body_bytes",
  "default_limits": {
    "max_payload_bytes": 2097152,
    "max_workflow_task_completion_bytes": 33554432
  },
  "completion_routes": [
    "/api/worker/workflow-tasks/fixture-task/complete",
    "/api/worker/activity-tasks/fixture-task/continuation/complete"
  ],
  "ordinary_route": "/api/workflows",
  "wire_cases": [
    {
      "id": "ordinary-exact",
      "route_kind": "ordinary",
      "wire_bytes": 2097152,
      "size_admitted": true
    },
    {
      "id": "ordinary-over",
      "route_kind": "ordinary",
      "wire_bytes": 2097153,
      "size_admitted": false
    },
    {
      "id": "completion-over-ordinary",
      "route_kind": "completion",
      "wire_bytes": 2097153,
      "size_admitted": true
    },
    {
      "id": "completion-exact",
      "route_kind": "completion",
      "wire_bytes": 33554432,
      "size_admitted": true
    },
    {
      "id": "completion-over",
      "route_kind": "completion",
      "wire_bytes": 33554433,
      "size_admitted": false
    }
  ],
  "oversized_response": {
    "status": 413,
    "reason": "payload_too_large",
    "limit_kind": "workflow_task_completion_bytes",
    "limit": 33554432
  },
  "scope": "Size admission alone. Authentication, lease fences, per-value Avro limits and command validation still apply; no durable work is admitted by a size refusal.",
  "negotiation_cases": [
    {
      "id": "absent",
      "limits": {
        "max_payload_bytes": 2097152
      },
      "expected": "ordinary_fallback"
    },
    {
      "id": "positive",
      "limits": {
        "max_payload_bytes": 2097152,
        "max_workflow_task_completion_bytes": 33554432
      },
      "expected": "completion_cap",
      "completion_cap": 33554432
    },
    {
      "id": "positive-smaller",
      "limits": {
        "max_payload_bytes": 2097152,
        "max_workflow_task_completion_bytes": 1024
      },
      "expected": "completion_cap",
      "completion_cap": 1024
    },
    {
      "id": "null",
      "limits": {
        "max_payload_bytes": 2097152,
        "max_workflow_task_completion_bytes": null
      },
      "expected": "refuse_completion_planning_before_upload_or_submission"
    },
    {
      "id": "zero",
      "limits": {
        "max_payload_bytes": 2097152,
        "max_workflow_task_completion_bytes": 0
      },
      "expected": "refuse_completion_planning_before_upload_or_submission"
    },
    {
      "id": "negative",
      "limits": {
        "max_payload_bytes": 2097152,
        "max_workflow_task_completion_bytes": -1
      },
      "expected": "refuse_completion_planning_before_upload_or_submission"
    },
    {
      "id": "float",
      "limits": {
        "max_payload_bytes": 2097152,
        "max_workflow_task_completion_bytes": 32.5
      },
      "expected": "refuse_completion_planning_before_upload_or_submission"
    },
    {
      "id": "string",
      "limits": {
        "max_payload_bytes": 2097152,
        "max_workflow_task_completion_bytes": "33554432"
      },
      "expected": "refuse_completion_planning_before_upload_or_submission"
    },
    {
      "id": "bool",
      "limits": {
        "max_payload_bytes": 2097152,
        "max_workflow_task_completion_bytes": true
      },
      "expected": "refuse_completion_planning_before_upload_or_submission"
    },
    {
      "id": "object",
      "limits": {
        "max_payload_bytes": 2097152,
        "max_workflow_task_completion_bytes": {}
      },
      "expected": "refuse_completion_planning_before_upload_or_submission"
    },
    {
      "id": "array",
      "limits": {
        "max_payload_bytes": 2097152,
        "max_workflow_task_completion_bytes": []
      },
      "expected": "refuse_completion_planning_before_upload_or_submission"
    }
  ],
  "negotiation_scope": "Only workflow-task completion and activity-continuation completion consume this field. Ordinary routes ignore it. Explicit invalid values refuse planning without upload/submission; absence preserves the existing conservative fallback."
}
