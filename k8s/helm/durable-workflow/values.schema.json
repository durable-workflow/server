{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "durable-workflow chart values",
  "type": "object",
  "additionalProperties": true,
  "required": ["image", "externalDatabase", "externalRedis"],
  "properties": {
    "runtime": {
      "type": "string",
      "enum": ["", "native", "php"],
      "description": "Server runtime. Empty runs native on a new install and keeps an existing native release native; an existing PHP release must choose explicitly."
    },
    "native": {
      "type": "object",
      "properties": {
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
        "automountServiceAccountToken": { "type": "boolean" },
        "ephemeralStorage": {
          "type": "object",
          "properties": {
            "request": { "type": ["string", "integer"] },
            "limit":   { "type": ["string", "integer"] }
          }
        },
        "storage": {
          "type": "object",
          "properties": {
            "existingClaim": { "type": "string" }
          }
        },
        "schemaUpgrade": {
          "type": "object",
          "properties": {
            "enabled":               { "type": "boolean" },
            "backoffLimit":          { "type": "integer", "minimum": 0 },
            "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
            "resources":             { "type": "object" }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "registry":   { "type": "string" },
        "repository": { "type": "string", "minLength": 1 },
        "tag":        { "type": "string" },
        "digest":     { "type": "string" },
        "memoPayloadStorage": {
          "type": "string",
          "enum": ["", "raw-json-v1", "envelope-v1", "dual-v1"]
        },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets":{ "type": "array",  "items": { "type": "object" } }
      }
    },
    "externalDatabase": {
      "type": "object",
      "required": ["connection", "database"],
      "properties": {
        "connection": { "type": "string", "enum": ["mysql", "mariadb", "pgsql"] },
        "host":       { "type": "string" },
        "port":       { "type": ["integer", "string"] },
        "database":   { "type": "string", "minLength": 1 },
        "socket":     { "type": "string" },
        "sslMode":    { "type": "string" },
        "tls": {
          "type": "object",
          "properties": {
            "existingSecret": { "type": "string" },
            "caKey": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" }
          }
        },
        "existingSecret":              { "type": "string" },
        "existingSecretUsernameKey":   { "type": "string" },
        "existingSecretPasswordKey":   { "type": "string" },
        "auth": {
          "type": "object",
          "properties": {
            "username": { "type": "string" },
            "password": { "type": "string" }
          }
        }
      }
    },
    "externalRedis": {
      "type": "object",
      "properties": {
        "host":     { "type": "string" },
        "port":     { "type": ["integer", "string"] },
        "database": { "type": ["integer", "string"] },
        "tls":      { "type": "boolean" },
        "existingSecret":              { "type": "string" },
        "existingSecretUsernameKey":   { "type": "string" },
        "existingSecretPasswordKey":   { "type": "string" },
        "auth": {
          "type": "object",
          "properties": {
            "username": { "type": "string" },
            "password": { "type": "string" }
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "serverKey":      { "type": "string" },
        "authToken":      { "type": "string" },
        "principalTokens":{ "type": "string" },
        "workerToken":    { "type": "string" },
        "operatorToken":  { "type": "string" },
        "adminToken":     { "type": "string" },
        "extra":          { "type": "object" }
      }
    },
    "scheduler": {
      "type": "object",
      "properties": {
        "enabled":           { "type": "boolean" },
        "schedule":          { "type": "string" },
        "concurrencyPolicy": {
          "type": "string",
          "enum": ["Forbid"],
          "description": "The single-region HA contract requires a singleton scheduler. Allow only Forbid; Allow/Replace would let multiple scheduler runs overlap and would silently break engine guarantees."
        }
      }
    }
  }
}
