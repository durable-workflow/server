{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://durable-workflow.github.io/schemas/capacity-benchmark-adapter/v1.json",
  "title": "Durable Workflow capacity benchmark adapter v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "suite_version",
    "binding",
    "artifact_key",
    "artifact",
    "entrypoint",
    "source_files",
    "worker_concurrency",
    "client_protocol",
    "workloads"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": "durable-workflow.capacity-benchmark-adapter/v1"},
    "suite_version": {"const": "1.4.0"},
    "binding": {"enum": ["php", "python", "rust"]},
    "artifact_key": {"enum": ["sdk_php", "sdk_python", "sdk_rust"]},
    "artifact": {"type": "object"},
    "entrypoint": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string", "minLength": 1}
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "worker_concurrency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "environment"],
      "properties": {
        "model": {"enum": ["processes", "slots"]},
        "environment": {"const": "DURABLE_WORKFLOW_WORKER_CONCURRENCY"}
      }
    },
    "client_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "operations"],
      "properties": {
        "transport": {"const": "stdin_stdout_jsonl"},
        "operations": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["start", "signal", "query", "result"]}
        }
      }
    },
    "workloads": {
      "type": "object",
      "minProperties": 9,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workflow_types", "activity_types", "signal_types", "query_types", "roles"],
        "properties": {
          "workflow_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "activity_types": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "signal_types": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "query_types": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    }
  }
}
