        {"language": "python", "roles": ["client", "workflow-worker"]},
        {"language": "rust", "roles": ["client", "workflow-worker"]}
      ],
      "execution": {"concurrent_open_workflows": 100, "client_concurrency": 16, "worker_concurrency": 32, "duration_seconds": 300, "warmup_seconds": 60, "deterministic_seed": 104729, "load_steps": [25, 50, 100, 200, 400], "termination": {"condition": "duration_elapsed_then_open_workflows_drained", "drain_timeout_seconds": 120}}
    },
    {
