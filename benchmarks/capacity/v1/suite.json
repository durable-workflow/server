{
  "$schema": "schemas/suite.schema.json",
  "schema": "durable-workflow.capacity-benchmark-suite/v1",
  "suite_version": "1.1.0",
  "status": "engineering_evidence_not_release_gate",
  "description": "Versioned, reproducible Durable Workflow capacity workloads. Throughput evidence does not substitute for correctness conformance.",
  "schemas": {
    "suite": "schemas/suite.schema.json",
    "infrastructure": "schemas/infrastructure.schema.json",
    "observation": "schemas/observation.schema.json",
    "result": "schemas/result.schema.json",
    "adapter": "schemas/adapter.schema.json",
    "collector": "schemas/collector.schema.json"
  },
  "artifacts": {
    "server": {
      "registry": "docker.io",
      "name": "durableworkflow/server",
      "version": "2.0.0-rc.25",
      "reference": "docker.io/durableworkflow/server:2.0.0-rc.25"
    },
    "workflow_php": {
      "registry": "packagist.org",
      "name": "durable-workflow/workflow",
      "version": "2.0.0-rc.14",
      "reference": "durable-workflow/workflow:2.0.0-rc.14"
    },
    "sdk_php": {
      "registry": "packagist.org",
      "name": "durable-workflow/sdk",
      "version": "2.0.0-rc.14",
      "reference": "durable-workflow/sdk:2.0.0-rc.14"
    },
    "sdk_python": {
      "registry": "pypi.org",
      "name": "durable-workflow",
      "version": "2.0.0rc25",
      "reference": "durable-workflow==2.0.0rc25"
    },
    "sdk_rust": {
      "registry": "crates.io",
      "name": "durable-workflow",
      "version": "2.0.0-rc.11",
      "reference": "durable-workflow@2.0.0-rc.11"
    }
  },
  "protocols": {
    "control_plane": "2",
    "worker": "1.2"
  },
  "required_metrics": [
    "offered_load_delivery",
    "workflow_start_attempts",
    "workflow_start_acceptances",
    "workflow_start_rejections",
    "workflow_start_throttles",
    "query_attempts",
    "query_acceptances",
    "query_completions",
    "query_rejections",
    "query_throttles",
    "workflow_starts_per_second",
    "workflow_completions_per_second",
    "activity_dispatches_per_second",
    "schedule_to_start_latency_ms",
    "replay_latency_ms",
    "query_latency_ms",
    "concurrent_open_workflows",
    "error_rate",
    "throttle_rate",
    "storage_growth_bytes",
    "saturation"
  ],
  "operating_point_rule": {
    "selection": "highest_load_step_meeting_every_limit_for_the_complete_measurement_window",
    "minimum_offered_load_delivery_ratio": 0.99,
    "minimum_completion_ratio": 0.99,
    "maximum_error_rate": 0.005,
    "maximum_throttle_rate": 0.01,
    "maximum_schedule_to_start_p99_ms": 1000,
    "maximum_replay_p99_ms": 2000,
    "maximum_query_p99_ms": 750,
    "maximum_cpu_utilization": 0.85,
    "maximum_memory_utilization": 0.85,
    "maximum_queue_backlog": 1000,
    "complete_measurement_window_required": true,
    "transient_spikes_are_ineligible": true
  },
  "driver_contract": {
    "protocol": "newline_delimited_capacity_observation_v1",
    "required_bindings": ["php", "python", "rust"],
    "matrix": "each_cell_by_each_first_party_binding",
    "controller": {
      "entrypoint": ["python3", "scripts/benchmark/capacity_matrix.py"],
      "source_files": ["scripts/benchmark/capacity_matrix.py"],
      "commands": ["dry-run", "run"]
    },
    "adapters": {
      "schema": "schemas/adapter.schema.json",
      "descriptor_pattern": "bindings/{binding}/adapter.json",
      "modes": ["describe", "worker", "client"],
      "client_protocol": "stdin_stdout_jsonl"
    },
    "collector": {
      "schema": "schemas/collector.schema.json",
      "descriptor": "collectors/local-docker/collector.json",
      "protocol": "stdin_stdout_jsonl",
      "operations": ["initialize", "sample"]
    },
    "artifact_installation": "install_every_exact_artifact_before_warmup_and_record_the_resolved_identity",
    "warmup": "discard_observations_until_the_declared_warmup_has_elapsed",
    "measurement": "emit_monotonic_interval_counters_including_attempted_accepted_completed_rejected_and_throttled_demand_plus_infrastructure_samples_for_the_complete_declared_duration",
    "termination": "stop_admission_then_drain_open_workflows_until_the_declared_condition",
    "server_capacity_comparison": "never_pool_bindings_or_unlike_result_identities"
  },
  "cadence": {
    "ordinary_source_change": [
      "validate_suite_schemas_and_regression_corpus",
      "run_bounded_non_publishable_reference_cell"
    ],
    "full_matrix_triggers": [
      "suite_version",
      "offered_resource_profile",
      "server_or_workflow_protocol_tuple",
      "database_major_or_minor",
      "redis_major_or_minor",
      "container_architecture",
      "kernel_or_runtime_profile",
      "scheduling_or_resource_limit_policy",
      "pricing_release_candidate",
      "monthly_drift_check"
    ],
    "failure_effect": "blocks_only_the_affected_capacity_claim_unless_a_separate_release_policy_says_otherwise",
    "provider_execution": "requires_separate_no_spend_authorization"
  },
  "publication_policy": {
    "customer_claim_current_when": "suite_artifacts_architecture_infrastructure_and_tier_resource_identity_all_exactly_match_the_offer",
    "identity_mismatch": "retain_as_historical_and_mark_stale",
    "carry_forward": "forbidden",
    "capacity_result_proves_correctness": false,
    "correctness_result_proves_capacity": false
  },
  "comparison_identity": [
    "suite_version",
    "suite_sha256",
    "source_revision",
    "artifacts",
    "infrastructure_profile",
    "infrastructure_profile_sha256",
    "architecture",
    "binding"
  ],
  "result_identity": [
    "suite_version",
    "suite_sha256",
    "source_revision",
    "artifacts",
    "infrastructure_profile",
    "infrastructure_profile_sha256",
    "architecture",
    "binding",
    "run_timestamp"
  ],
  "privacy": {
    "allowed": [
      "synthetic_payloads",
      "public_artifact_coordinates",
      "coarse_reproducible_infrastructure_profiles"
    ],
    "forbidden": [
      "customer_data",
      "credentials",
      "provider_account_details",
      "private_fleet_topology"
    ]
  },
  "cells": [
    {
      "id": "simple-start-complete",
