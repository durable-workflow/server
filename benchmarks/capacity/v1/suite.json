    {
      "id": "query-inspection",
      "description": "Keep workflows open and issue five deterministic read-only inspections per second per load unit.",
      "artifacts": {
        "server": {"registry": "docker.io", "name": "durableworkflow/server", "version": "2.0.0-rc.25", "reference": "docker.io/durableworkflow/server:2.0.0-rc.25"},
        "workflow_php": {"registry": "packagist.org", "name": "durable-workflow/workflow", "version": "2.0.0-rc.14", "reference": "durable-workflow/workflow:2.0.0-rc.14"},
