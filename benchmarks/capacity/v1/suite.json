        "sdk_php": {"registry": "packagist.org", "name": "durable-workflow/sdk", "version": "2.0.0-rc.14", "reference": "durable-workflow/sdk:2.0.0-rc.14"},
        "sdk_python": {"registry": "pypi.org", "name": "durable-workflow", "version": "2.0.0rc25", "reference": "durable-workflow==2.0.0rc25"},
        "sdk_rust": {"registry": "crates.io", "name": "durable-workflow", "version": "2.0.0-rc.11", "reference": "durable-workflow@2.0.0-rc.11"}
      },
      "workload": {
        "workflow": {"type": "capacity.v1.simple", "steps": ["accept_input", "return_input"]},
        "activities": [],
        "signals": [],
        "queries": [],
        "payload": {"codec": "avro", "workflow_input_bytes": 1024, "workflow_result_bytes": 1024, "activity_input_bytes": 0, "activity_result_bytes": 0, "signal_bytes": 0},
        "history": {"target_event_count": 3, "shape": ["workflow_started", "workflow_task_completed", "workflow_completed"]}
