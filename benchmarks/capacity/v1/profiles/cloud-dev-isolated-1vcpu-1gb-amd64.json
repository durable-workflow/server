{
  "$schema": "../schemas/infrastructure.schema.json",
  "schema": "durable-workflow.capacity-benchmark-infrastructure/v1",
  "profile_id": "cloud-dev-isolated-1vcpu-1gb-amd64-v1",
  "description": "Provider-neutral isolated single-host development cell with direct runtime ingress and an off-host backup role; no availability SLA.",
  "architecture": {
    "machine": "x86_64",
    "container": "linux/amd64"
  },
  "runtime": {
    "kernel_profile": "linux-6.8.0-138-generic-cgroup-v2",
    "container_engine": "docker-29.1.3",
    "containerd_version": "2.2.1",
    "runc_version": "1.3.4-0ubuntu1~24.04.1",
    "docker_init_version": "0.19.0",
    "operating_system": "ubuntu-24.04",
    "default_runtime": "runc",
    "cgroup_version": "2",
    "cgroup_driver": "systemd",
    "storage_driver": "overlayfs",
    "scheduling_policy": "single-host-container-memory-limits-v1"
  },
  "networking": {
    "driver": "bridge",
    "internal": false,
    "attachable": false,
    "service_networks": 1
  },
  "components": {
    "runtime-host": {
      "cpu_cores": 1,
      "memory_bytes": 1001873408,
      "image": "ubuntu:24.04-host-kernel-6.8.0-138-generic"
    },
    "server": {
      "cpu_cores": 1,
      "memory_bytes": 184549376,
      "image": "docker.io/durableworkflow/server:2.1.1@sha256:be7dd52fdb4ce32994f4af25e682eb6fc11a15497b8e7f93bb0e0d06a2406642"
    },
    "server-worker": {
      "cpu_cores": 1,
      "memory_bytes": 117440512,
      "image": "docker.io/durableworkflow/server:2.1.1@sha256:be7dd52fdb4ce32994f4af25e682eb6fc11a15497b8e7f93bb0e0d06a2406642"
    },
    "scheduler": {
      "cpu_cores": 1,
      "memory_bytes": 83886080,
      "image": "docker.io/durableworkflow/server:2.1.1@sha256:be7dd52fdb4ce32994f4af25e682eb6fc11a15497b8e7f93bb0e0d06a2406642"
    },
    "mysql": {
      "cpu_cores": 1,
      "memory_bytes": 335544320,
      "image": "docker.io/library/mysql@sha256:7dcddc01f13bab2f15cde676d44d01f61fc9f99fe7785e86196dfc07d358ae2b"
    },
    "redis": {
      "cpu_cores": 1,
      "memory_bytes": 33554432,
      "image": "docker.io/library/redis@sha256:ff02b58f971e7d7d156a1267e283fcbbeee91773b6aa36c49dac28ecfe28eadf"
    },
    "runtime-ingress": {
      "cpu_cores": 1,
      "memory_bytes": 50331648,
      "image": "docker.io/cloudflare/cloudflared:2026.8.3@sha256:9be48e4b4e996da851bf78f7782bfab150dd4d8889e469d004802e7d7afb63b1"
    },
    "backup": {
      "cpu_cores": 1,
      "memory_bytes": 50331648,
      "image": "cloud-dev-runtime-backup@sha256:7dd06ac1b051dc3531a76693976c201af1c2010d8d3a418bdb02178e97de094c"
    },
    "sdk-php-worker": {
      "cpu_cores": 4,
      "memory_bytes": 16618160128,
      "image": "ghcr.io/durable-workflow/sample-app-devcontainer@sha256:094d6841b4e4816cd649eb0d034fed76e99ed9ea9ecf626bbdde27f1160610e0"
    },
    "sdk-python-worker": {
      "cpu_cores": 4,
      "memory_bytes": 16618160128,
      "image": "ghcr.io/durable-workflow/sample-app-devcontainer@sha256:094d6841b4e4816cd649eb0d034fed76e99ed9ea9ecf626bbdde27f1160610e0"
    },
    "sdk-rust-worker": {
      "cpu_cores": 4,
      "memory_bytes": 16618160128,
      "image": "ghcr.io/durable-workflow/sample-app-devcontainer@sha256:094d6841b4e4816cd649eb0d034fed76e99ed9ea9ecf626bbdde27f1160610e0"
    },
    "load-generator": {
      "cpu_cores": 4,
      "memory_bytes": 16618160128,
      "image": "ghcr.io/durable-workflow/sample-app-devcontainer@sha256:094d6841b4e4816cd649eb0d034fed76e99ed9ea9ecf626bbdde27f1160610e0"
    }
  },
  "server": {
    "configuration": "cloud-dev-isolated-single-host-direct-ingress-v1",
    "environment": {
      "APP_DEBUG": "false",
      "APP_ENV": "production",
      "APP_VERSION": "2.1.1",
      "CACHE_STORE": "redis",
      "DB_CONNECTION": "mysql",
      "DB_DATABASE": "durable_workflow",
      "DB_HOST": "mysql",
      "DB_PORT": "3306",
      "DB_USERNAME": "workflow",
      "DW_AUTH_DRIVER": "token",
      "DW_EXTERNAL_PAYLOAD_MAX_BYTES": "67108864",
      "DW_MODE": "service",
      "DW_RUNTIME_CREDENTIALS_ENABLED": "true",
      "DW_SERVER_TOPOLOGY_SHAPE": "standalone_server",
      "QUEUE_CONNECTION": "redis",
      "REDIS_HOST": "redis"
    },
    "process_classes": {
      "server": "server_http_node",
      "server-worker": "worker_node",
      "scheduler": "scheduler_node"
    },
    "worker_command": [
      "php",
      "/opt/durable-workflow/cloud-scheduler/dependency-gate.php",
      "run",
      "--",
      "php",
      "artisan",
      "queue:work",
      "--sleep=1",
      "--tries=3"
    ],
    "scheduler_command": [
      "php",
      "/opt/durable-workflow/cloud-scheduler/dependency-gate.php",
      "run",
      "--",
      "php",
      "/opt/durable-workflow/cloud-scheduler/scheduler-leader.php"
    ]
  },
  "durable_storage": {
    "driver": "local-volume",
    "medium": "nvme-ssd",
    "mount_options": "ext4-defaults",
    "capacity_bytes": 24566575104,
    "capacity_policy": "minimum",
    "database_destination": "/var/lib/mysql",
    "redis_destination": "/data"
  },
  "database": {
    "engine": "mysql",
    "version": "8.0.46",
    "configuration": "cloud-dev-single-host-mysql-v1",
    "parameters": {
      "innodb_buffer_pool_size": "67108864",
      "innodb_doublewrite": "ON",
      "innodb_flush_log_at_trx_commit": "1",
      "innodb_log_buffer_size": "8388608",
      "log_bin": "OFF",
      "max_connections": "40",
      "max_heap_table_size": "16777216",
      "performance_schema": "OFF",
      "sync_binlog": "1",
      "table_open_cache": "256",
      "tmp_table_size": "16777216"
    }
  },
  "redis": {
    "engine": "redis",
    "version": "7.4.11",
    "configuration": "cloud-dev-single-host-redis-v1",
    "parameters": {
      "appendfsync": "everysec",
      "appendonly": "yes",
      "maxmemory": "16777216",
      "maxmemory-policy": "noeviction",
      "save": "3600 1 300 100 60 10000"
    }
  }
}
